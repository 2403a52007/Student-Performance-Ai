import pandas as pd
from sklearn.linear_model import LinearRegression
import pickle

# Example dataset (you can change values)
# Features: study hours, attendance, previous marks
X = [
    [2, 60, 50],
    [3, 65, 55],
    [4, 70, 60],
    [5, 75, 65],
    [6, 80, 70],
    [7, 85, 75],
    [8, 90, 80]
]

# Target: final score
y = [55, 60, 65, 70, 75, 80, 85]

# Train model
model = LinearRegression()
model.fit(X, y)

# Save model
pickle.dump(model, open("model.pkl", "wb"))

print("model.pkl created successfully")
