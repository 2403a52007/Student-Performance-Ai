import numpy as np
from sklearn.linear_model import LinearRegression
import joblib

X = np.array([
    [2, 60, 50],
    [3, 65, 55],
    [4, 70, 60],
    [5, 75, 65],
    [6, 80, 70],
    [7, 85, 75],
    [8, 90, 80]
])

y = np.array([55, 60, 65, 70, 75, 80, 85])

model = LinearRegression()
model.fit(X, y)

joblib.dump(model, "model.pkl")
