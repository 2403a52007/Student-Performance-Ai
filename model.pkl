import numpy as np
from sklearn.linear_model import LinearRegression
import pickle

# Features: [Study Hours, Attendance, Previous Marks]
X = np.array([
    [2, 60, 50],
    [3, 65, 55],
    [4, 70, 60],
    [5, 75, 65],
    [6, 80, 70],
    [7, 85, 75],
    [8, 90, 80]
])

# Target: Final Score
y = np.array([55, 60, 65, 70, 75, 80, 85])

# Train model
model = LinearRegression()
model.fit(X, y)

# Save model
with open("model.pkl", "wb") as f:
    pickle.dump(model, f)

print("model.pkl created successfully")
